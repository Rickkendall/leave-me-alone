{
  "manifest_version": 3,
  "name": "Leave Me Alone",
  "short_name": "LeaveMeAlone",
  "version": "1.1.0",
  "description": "Anti-tracking from mild to paranoid: blocks trackers, third-party cookies, link tracking and browser fingerprinting.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Leave Me Alone",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "scripting",
    "tabs",
    "cookies",
    "browsingData",
    "privacy",
    "contentSettings"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
